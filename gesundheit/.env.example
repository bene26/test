# Copy this file to .env (same folder as docker-compose.yml) and fill it in.
# .env stays on the NAS and never goes into Git.

# Port on the NAS and the address you open in the browser. Withings needs exactly this
# address (plus /quellen/withings/zurueck) as the callback URL of your Withings application.
GESUNDHEIT_PORT=6767
GESUNDHEIT_BASE_URL=http://192.168.1.10:6767

# Time zone for days, nights and timestamps.
TZ=Europe/Berlin

# User and group the app runs as. UGOS: run `id` via SSH to see your own IDs.
PUID=1000
PGID=1000

# Only set to true when the app runs behind a reverse proxy with HTTPS.
GESUNDHEIT_SECURE_COOKIES=false
GESUNDHEIT_TRUST_PROXY=false

# How often Withings and Garmin are synced (minutes, at least 15).
GESUNDHEIT_SYNC_MINUTES=60

# Largest Apple Health export that can be uploaded in the browser (MB). Bigger files go
# into the folder ./import and are read from there (Quellen → Apple Health).
GESUNDHEIT_UPLOAD_MAX_MB=2048

# Optional: key for encrypting the Withings and Garmin tokens. Empty = the app creates the
# file data/schluessel on first start. Generate one with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GESUNDHEIT_KEY=

# Optional: Withings application (developer.withings.com). Can also be entered on the
# Quellen page, where it is stored encrypted.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
