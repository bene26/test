# Copy this file to .env (same folder as docker-compose.yml) and fill it in.
# .env stays on the NAS and never goes into Git.

# Port on the NAS and the address you open in the browser.
COCKPIT_PORT=8080
COCKPIT_BASE_URL=http://192.168.1.10:8080

# Time zone for reminders and timestamps.
TZ=Europe/Berlin

# User and group the app runs as. UGOS: run `id` via SSH to see your own IDs.
PUID=1000
PGID=1000

# Only set to true when the cockpit runs behind a reverse proxy with HTTPS.
COCKPIT_SECURE_COOKIES=false
COCKPIT_TRUST_PROXY=false

# --- Push to the phone via the ntfy app (see docs/installation-ugreen.md) ---
# Public server: https://ntfy.sh (only counts and a link are sent, no content).
NTFY_URL=https://ntfy.sh
# Long, random topic name. Anyone who knows it can read the reminders.
NTFY_TOPIC=
# Only needed for your own ntfy server with access control.
NTFY_TOKEN=

# --- E-mail (sending protocols, optional reminders) ---
SMTP_HOST=
SMTP_PORT=587
# starttls, ssl or none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Leave empty if reminders should only go to the phone.
REMINDER_EMAIL_TO=
